# Trazo Frontend Environment Variables (Vite)

# API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Social Authentication Configuration
# Get these from the respective OAuth provider consoles

# Google OAuth 2.0
# Get from: https://console.developers.google.com/
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Facebook OAuth 2.0  
# Get from: https://developers.facebook.com/
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here

# Apple Sign In
# Get from: https://developer.apple.com/
VITE_APPLE_CLIENT_ID=your_apple_client_id_here

# Blockchain Explorer URL (testnet for dev, mainnet for prod)
VITE_POLYGON_EXPLORER_URL=https://amoy.polygonscan.com

# Payments - set to 'true' when Stripe Atlas is live
VITE_APP_PAYMENTS_ENABLED=false

# Other configuration (if needed)
VITE_ENVIRONMENT=development