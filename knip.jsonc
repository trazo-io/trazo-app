{
  "$schema": "https://unpkg.com/knip@2/schema.json",

  // Vite entry, as referenced by index.html. Pinned because an unset or wrong entry silently
  // produces a bogus unused-file graph — and this config is used to decide what gets DELETED.
  "entry": ["src/index.tsx"],
  "project": ["src/**/*.{js,jsx,ts,tsx}"],

  "ignore": [
    // ⚠️ These three are LIVE modules, not dead ones. Each has a sibling `.d.ts` describing
    // it, and knip resolves the import specifier to the declaration file — so it sees the
    // real `.js`/`.jsx` as unreferenced and lists it as unused. Deleting any of them breaks
    // the app at runtime: historyApi alone backs 20 importers.
    //
    // This is the same shape as the bug that motivated the `.d.ts` files in the first place
    // (a stale `historyApi.ts` shadowing `historyApi.js`, with Vite and TypeScript resolving
    // to different modules). Do not remove these entries without first confirming knip no
    // longer treats a `.d.ts` as the definition of its sibling.
    "src/store/api/historyApi.js",
    "src/store/api/reviewApi.js",
    "src/components/Map/CardWithMap.jsx",

    // Generated by scripts/typegen.sh; churn, not authored code.
    "src/types/api.generated.ts"
  ],

  "ignoreExportsUsedInFile": true
}
